    "write": true,
    "fields": {
      "username": {
        "type": "string",
        "pattern": "^@?[A-Za-z0-9_]{1,15}$"
      }
    }
  },
  "mute": {
    "method": "mute",
    "description": "Mute one specified user.",
    "write": true,
    "fields": {
      "username": {
        "type": "string",
        "pattern": "^@?[A-Za-z0-9_]{1,15}$"
      }

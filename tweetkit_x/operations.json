      "username": {
        "type": "string",
        "pattern": "^@?[A-Za-z0-9_]{1,15}$"
      }
    }
  },
  "publishMedia": {
    "method": "post",
    "description": "Publish with one image supplied as base64, not a local path.",
    "write": true,
    "fields": {
      "text": {
        "type": "string",
        "minLength": 1,
        "maxLength": 25000
      },
      "media_base64": {
        "type": "string",
        "minLength": 1,
        "maxLength": 280000
      },
      "media_type": {
        "type": "string",
        "enum": [
          "image/png",
          "image/jpeg",
          "image/webp",
          "image/gif"
        ]
      },
      "reply_to": {
        "type": "string",
        "pattern": "^[0-9]{1,25}$",
        "optional": true
      }
    }
  }
